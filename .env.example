# SignalX production delivery
# Keep these values in Vercel Project Settings -> Environment Variables.
# NEVER commit real secrets.

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=
WHATSAPP_GRAPH_VERSION=v25.0

# Optional approved WhatsApp template for outbound messages outside
# the customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional protection for the public /api/send endpoint.
SIGNALX_SEND_KEY=
